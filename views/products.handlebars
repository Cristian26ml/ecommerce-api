<div class="container mt-4">
    <h1>Lista de productos</h1>
    <div class="row">
        {{#each products}}
            <div class="card mb-3">
                {{#if this.thumbnails.[0]}}
                    <img src="{{this.thumbnails.[0]}}" class="card-img-top" alt="{{this.title}}">
                {{/if}}
                <div class="card-body">
                    <h5 class="card-title">{{this.title}}</h5>
                    <p>Código: {{this.code}}</p>
                    <p>Descripción: {{this.description}}</p>
                    <p>Categoría: {{this.category}}</p>
                    <p>Precio: ${{this.price}}</p>
                    <p>Stock: {{this.stock}}</p>

                    {{#if (eq ../user.role "admin")}}
                        <a href="/products/{{this._id}}/edit" class="btn btn-warning">Editar producto</a>
                        <form action="/products/{{this._id}}" method="POST" class="form-inline">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-danger">Eliminar producto</button>
                        </form>
                    {{/if}}

                    {{#if (eq ../user.role "cliente")}}
                        {{#if ../user.cartId}}
                            <form action="/api/carts/{{../user.cartId}}/products/{{this._id}}" method="POST" class="form-inline">
                                <button type="submit" class="btn btn-primary">Agregar al carrito</button>
                            </form>
                        {{else}}
                            <p class="text-muted">No tienes un carrito asignado</p>
                        {{/if}}
                    {{/if}}
                </div>
            </div>
        {{/each}}
        {{#if (eq user.role "admin")}}
            <a href="/dashboard/admin" class="btn btn-secondary mt-3">Volver al Dashboard Admin</a>
        {{/if}}

    </div>
</div>

{{#if user.cartId}}
    <a href="/carts/{{user.cartId}}">
        <button class="btn btn-success">Ver carrito</button>
    </a>
    <a href="/dashboard/cliente" class="btn btn-secondary">Volver a Página principal</a>
{{/if}}

<script src="/socket.io/socket.io.js"></script>
<script src="/js/products.js"></script>