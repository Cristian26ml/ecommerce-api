<h1>Detalle de Orden</h1>

<p><strong>ID:</strong> {{order._id}}</p>
<p><strong>Usuario activo:</strong> {{user.username}} ({{user.role}})</p>
<p><strong>Fecha:</strong> {{formatDate order.createdAt}}</p>
<p><strong>Estado:</strong> {{order.status}}</p>
<p><strong>Total:</strong> ${{order.total}}</p>

<h3>Productos:</h3>
<ul>
    {{#each order.products}}
        <li>
            <strong>{{this.product.title}}</strong>  
            - Precio: ${{this.product.price}}  
            - Cantidad: {{this.quantity}}  
            - Subtotal: ${{multiply this.product.price this.quantity}}
        </li>
    {{/each}}
</ul>

{{#if (eq user.role "cliente")}}
    <div class="mt-3">
        <a href="/products" class="btn btn-primary">Seguir comprando</a>
        <a href="/dashboard/cliente" class="btn btn-secondary">Volver a Página principal</a>
    </div>
{{/if}}

{{#if (eq user.role "operario")}}
    <a href="/orders" class="btn btn-secondary">Volver al listado</a>
{{/if}}

{{#if (eq user.role "admin")}}
    {{#unless (eq order.status "Enviado")}}
        <form action="/orders/{{order._id}}/ship" method="POST" style="display:inline;">
            <button type="submit" class="btn btn-info">Marcar como Enviado</button>
        </form>
    {{/unless}}
    <a href="/orders" class="btn btn-secondary">Volver al listado</a>
{{/if}}